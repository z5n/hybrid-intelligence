# Copy this file to hi_website/.env for local overrides.
# On Vercel, set the same names under Project → Settings → Environment Variables.
# Do not commit hi_website/.env.

# Required on Vercel. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# On Vercel this defaults to false. Locally it defaults to true.
# DJANGO_DEBUG=false

# Extra hosts, comma-separated. .vercel.app is added automatically on Vercel.
# Add a custom domain here, and the matching https origin below.
# DJANGO_ALLOWED_HOSTS=hybrid-intelligence.org
# DJANGO_CSRF_TRUSTED_ORIGINS=https://hybrid-intelligence.org

# Leave empty locally to keep using hi_website/db.sqlite3.
# On Vercel, create a Postgres database (Storage → Neon). Vercel sets DATABASE_URL.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Public address of the chatbot (Chatbot/api.py). That server is not part of
# the Vercel deploy: it needs Ollama. The default talks to your own computer.
# CHATBOT_API_URL=http://127.0.0.1:8000
